# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Nebius Token Factory / Nebius AI Cloud Configuration
# Get your API key at https://tokenfactory.nebius.com / https://studio.nebius.ai
NEBIUS_API_KEY="your-nebius-token-factory-api-key"
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1"
NEBIUS_MODEL="nvidia/Llama-3.1-Nemotron-70B-Instruct-HF"

# AI Provider Configuration: 'nebius' (real NVIDIA Nemotron inference) or 'mock' (deterministic fallback)
AI_PROVIDER="mock"

# Server Port
PORT=3000

